    </PackageReference>
    <PackageReference Include="bunit" Version="1.35.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\OpenCredentials.Shared.csproj" />
